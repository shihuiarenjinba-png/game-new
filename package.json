    "audit:msix": "node scripts/msix-preflight.cjs",
    "verify:msix:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-msix.ps1",
    "make:logos": "node scripts/make-brand-assets.cjs",
    "audit:store-release": "node scripts/store-release-audit.cjs",
    "test:triple:win": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/run-triple-acceptance-win.ps1",
