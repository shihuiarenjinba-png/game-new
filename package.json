{
  "name": "handover-room-prototype",
  "version": "1.0.0",
  "private": true,
  "description": "Handover Room v0.16 QA candidate: clear offline UI and gated Store MSIX; release HOLD",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:product": "node --test tests/v2.test.cjs",
    "start:desktop": "electron .",
    "build:msix": "node scripts/store-build.cjs",
    "test:edge:win": "node scripts/windows-edge-smoke.cjs",
    "test:edge:accessibility:win": "node scripts/windows-edge-accessibility.cjs",
    "test:edge:save:win": "node scripts/windows-edge-save-transfer.cjs",
